{
	"name": "running-daily",
	"version": "0.1.0",
	"description": "Obsidian plugin: a running daily log in one note with automatic day headings, carried-over tasks and cycling task statuses.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "node --test \"src/**/*.test.ts\"",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"daily-notes",
		"tasks"
	],
	"author": "Alexander Gusev",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^9.39.4",
		"@types/node": "^24.0.0",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.14.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
